# Copy to .env in this folder (gitignored) and fill in only what you use.
# ./firecrawl-mcp and ./run (the Python tools container) both read it.

# Firecrawl MCP, used by the firecrawl-* skills and /seo firecrawl. https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Optional, for claude-seo. A Google API key enables PageSpeed Insights and CrUX field data.
# GOOGLE_API_KEY=
# GSC_PROPERTY=sc-domain:example.com
# MOZ_API_KEY=
# BING_WEBMASTER_API_KEY=
# KEYWORDSEVERYWHERE_API_KEY=

# Let claude-seo fetch the local dev server. Its fetchers refuse private addresses unless they are listed here.
# CLAUDE_SEO_LOCAL_TARGETS=host.docker.internal:3000
